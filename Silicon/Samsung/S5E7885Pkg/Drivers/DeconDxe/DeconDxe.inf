[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = DeconDxe
  FILE_GUID                      = 6D2D99B7-2E33-4D59-A615-F30A42C68C7E
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = DeconDxeEntry

[Sources]
  DeconDxe.c
  S5E7885Display.h
  Decon/Decon.c
  Dsim/Dsim.c
  Dsim/DsimPhyTable.h
  Panel/Hx8279d.c
  Panel/Hx8279dParam.h
  Platform/Platform.c
  Regs/RegsDecon.h
  Regs/RegsDpp.h
  Regs/RegsDsim.h

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  SiliciumPkg/SiliciumPkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  DebugLib
  IoLib
  MemoryMapHelperLib
  PcdLib
  TimerLib
  UefiDriverEntryPoint

[Pcd]
  gSiliciumPkgTokenSpaceGuid.PcdFrameBufferWidth
  gSiliciumPkgTokenSpaceGuid.PcdFrameBufferHeight
  gSiliciumPkgTokenSpaceGuid.PcdFrameBufferColorDepth

[Protocols]
