[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = FastbootApp
  FILE_GUID                      = 7C3F1E52-9A64-4B8D-A1D2-5E0B6C47F3A9
  MODULE_TYPE                    = UEFI_APPLICATION
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = FastbootAppEntry

[Sources]
  FastbootApp.c
  BootLinux.c
  DtboMerge.c
  FastbootCommands.c
  FastbootStorage.c
  FastbootUsb.c
  FastbootVars.c

[Packages]
  MdePkg/MdePkg.dec
  SiliciumPkg/SiliciumPkg.dec
  SamsungPkg/SamsungPkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  CacheMaintenanceLib
  DebugLib
  FdtLib
  MemoryAllocationLib
  PcdLib
  PrintLib
  PlatformPrebootLib
  UefiApplicationEntryPoint
  UefiBootServicesTableLib
  UefiLib
  UefiRuntimeServicesTableLib

[Protocols]
  gEfiUsbFunctionIoProtocolGuid
  gEfiBlockIoProtocolGuid
  gEfiEraseBlockProtocolGuid
  gEfiPartitionInfoProtocolGuid

[FixedPcd]
  gSamsungPkgTokenSpaceGuid.PcdFastbootMaxDownloadSize
  gSiliciumPkgTokenSpaceGuid.PcdSmbiosSystemRetailModel
  gSiliciumPkgTokenSpaceGuid.PcdSmbiosSystemModel
